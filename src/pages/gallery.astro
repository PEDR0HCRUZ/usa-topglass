---
import fs from 'fs'
import path from 'path'
import Layout from '../layouts/Layout.astro'
import { Navbar } from '../components/Navbar'
import { GalleryPage } from '../components/GalleryPage'
import { Footer } from '../components/Footer'

const IMAGE_EXTS = /\.(jpg|jpeg|png|webp|gif|JPG|JPEG|PNG|WEBP)$/i
const galleryDir = path.resolve('./public/media/gallery-medias')

const photos = fs.readdirSync(galleryDir)
  .filter(f => IMAGE_EXTS.test(f))
  .sort()
  .map(f => ({
    src: `/media/gallery-medias/${encodeURIComponent(f)}`,
    label: 'Glass Project',
  }))
---

<Layout
  title="Gallery — USA Top Glass | Frameless Shower Door Projects in Myrtle Beach"
  description="Browse our portfolio of frameless shower doors, custom glass enclosures and bathroom glass installations in Myrtle Beach, SC. Real projects, real results."
  keywords="glass shower door gallery myrtle beach, frameless shower photos, custom glass projects south carolina, shower enclosure before after"
  canonical="/gallery"
>
  <Navbar client:load />
  <GalleryPage photos={photos} client:load />
  <Footer />
</Layout>
