<script>
  // ─────────────────────────────────────────────
  // HERO — CSS animation on page load
  // ─────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-hero-animate]').forEach((el, i) => {
    el.style.animation = `heroFadeUp 0.6s ease ${80 + i * 130}ms both`
  })

  // ─────────────────────────────────────────────
  // SCROLL FADE-IN — IntersectionObserver
  // Triggers as soon as element enters the viewport
  // ─────────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const el = entry.target as HTMLElement
        const delay = el.style.getPropertyValue('--anim-delay') || '0ms'
        el.style.setProperty('--anim-delay', delay)
        el.classList.add('is-visible')
        observer.unobserve(el)
      })
    },
    { threshold: 0.08, rootMargin: '0px 0px -10px 0px' }
  )

  function observe(sel: string, staggerMs = 0) {
    document.querySelectorAll<HTMLElement>(sel).forEach((el, i) => {
      el.classList.add('will-animate')
      if (staggerMs > 0) el.style.setProperty('--anim-delay', `${i * staggerMs}ms`)
      observer.observe(el)
    })
  }

  observe('.section-tag')
  observe('section h2')
  observe('[data-section="trust"] > div > div', 80)
  observe('[data-section="services"] .group', 90)
  observe('[data-section="whyus"] .whyus-left')
  observe('[data-section="whyus"] .whyus-right')
  observe('[data-section="gallery"] .group', 60)
  observe('[data-section="contact"] form')
  observe('section p')

</script>
